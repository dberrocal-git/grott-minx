# Home Assistant MQTT sensors for grott-minx.
#
# Devices covered:
# - Growatt MIN 6000TL-XH inverter (+ APX battery: BDC/BMS entities)
# - Eastron SDM230 smart meter (via Growatt Raillog / datalogger)
#
# Usage:
# 1. Copy this file to your Home Assistant config as mqtt_sensors/growatt.yaml.
# 2. Replace <INVERTER_SERIAL> and <DATALOGGER_SERIAL> with your own serials
#    (they appear as the "device" field of the MQTT payload published by grott-minx,
#    or in its DEBUG logs).
# 3. Include the folder from configuration.yaml:
#
#      mqtt:
#        sensor: !include_dir_merge_list mqtt_sensors
#
# Values arrive as raw registers; the value_templates below apply the scale factors.

################################
# INVERSOR GROWATT - ESTADO    #
################################

# Estado del inversor
- state_topic: "energy/growatt"
  unique_id: "inverter_status"
  name: "Status"
  value_template: >-
    {% if value_json.device == '<INVERTER_SERIAL>' %}
      {{ value_json['values']['pvstatus'] }}
    {% endif %}
  icon: "mdi:information-outline"
  expire_after: 120
  state_class: "measurement"
  device: &growatt_device
    identifiers: ["<INVERTER_SERIAL>-2"]
    name: "Growatt Inverter"
    manufacturer: "Growatt"
    model: "MIN 6000TL-XH"

# Código de fallo
- state_topic: "energy/growatt"
  unique_id: "fault_code"
  name: "Fault Code"
  value_template: >-
    {% if value_json.device == '<INVERTER_SERIAL>' %}
      {{ value_json['values']['faultcode'] }}
    {% endif %}
  icon: "mdi:alert-circle"
  state_class: "measurement"
  expire_after: 120
  device: *growatt_device

# Código de advertencia
- state_topic: "energy/growatt"
  unique_id: "warning_code"
  name: "Warning Code"
  value_template: >-
    {% if value_json.device == '<INVERTER_SERIAL>' %}
      {{ value_json['values']['warningcode'] }}
    {% endif %}
  icon: "mdi:alert"
  state_class: "measurement"
  expire_after: 120
  device: *growatt_device

# Tiempo de trabajo total
- state_topic: "energy/growatt"
  unique_id: "total_working_time"
  name: "Total Working Time"
  value_template: >-
    {% if value_json.device == '<INVERTER_SERIAL>' %}
      {{ (value_json['values']['totworktime'] | int * 0.5) / 3600 }}
    {% endif %}
  unit_of_measurement: "h"
  device_class: "duration"
  state_class: "total_increasing"
  icon: "mdi:clock-outline"
  expire_after: 120
  device: *growatt_device

# Estado BDC On/Off
- state_topic: "energy/growatt"
  unique_id: "inverter_bdc_onoff_state"
  name: "BDC On/Off State"
  value_template: >-
    {% if value_json.device == '<INVERTER_SERIAL>' %}
      {{ value_json['values']['bdconoffstate'] }}
    {% endif %}
  icon: "mdi:toggle-switch"
  state_class: "measurement"
  expire_after: 120
  device: *growatt_device

# Estado del contacto seco
- state_topic: "energy/growatt"
  unique_id: "inverter_drycontact_state"
  name: "Dry Contact State"
  value_template: >-
    {% if value_json.device == '<INVERTER_SERIAL>' %}
      {{ value_json['values']['drycontactstate'] }}
    {% endif %}
  icon: "mdi:electric-switch"
  state_class: "measurement"
  expire_after: 120
  device: *growatt_device

# Prioridad de operación
- state_topic: "energy/growatt"
  unique_id: "inverter_priority"
  name: "Operating Priority"
  value_template: >-
    {% if value_json.device == '<INVERTER_SERIAL>' %}
      {{ value_json['values']['priority'] }}
    {% endif %}
  icon: "mdi:priority-high"
  state_class: "measurement"
  expire_after: 120
  device: *growatt_device

# Standby Flag
- state_topic: "energy/growatt"
  unique_id: "inverter_standby_flag"
  name: "Standby Status"
  value_template: >-
    {% if value_json.device == '<INVERTER_SERIAL>' %}
      {{ value_json['values']['standbyflag'] }}
    {% endif %}
  icon: "mdi:sleep"
  state_class: "measurement"
  expire_after: 120
  device: *growatt_device

# Derating Mode
- state_topic: "energy/growatt"
  unique_id: "inverter_derating_mode"
  name: "Derating Mode"
  value_template: >-
    {% if value_json.device == '<INVERTER_SERIAL>' %}
      {{ value_json['values']['deratingmode'] }}
    {% endif %}
  icon: "mdi:tune"
  state_class: "measurement"
  expire_after: 120
  device: *growatt_device

# Tiempo de inicio retardado del inversor
- state_topic: "energy/growatt"
  unique_id: "inverter_startdelaytime"
  name: "Inverter Start Delay Time"
  value_template: >-
    {% if value_json.device == '<INVERTER_SERIAL>' %}
      {{ value_json['values']['invstartdelaytime'] }}
    {% endif %}
  unit_of_measurement: "s"
  device_class: "duration"
  state_class: "measurement"
  icon: "mdi:timer-outline"
  expire_after: 120
  device: *growatt_device

# Porcentaje de operación real
- state_topic: "energy/growatt"
  unique_id: "inverter_realoppercent"
  name: "Operation Percentage"
  value_template: >-
    {% if value_json.device == '<INVERTER_SERIAL>' %}
      {{ value_json['values']['realoppercent'] }}
    {% endif %}
  unit_of_measurement: "%"
  state_class: "measurement"
  icon: "mdi:percent"
  expire_after: 120
  device: *growatt_device


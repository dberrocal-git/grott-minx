  icon: "mdi:battery-arrow-down"
  expire_after: 120
  device: *growatt_device

# Energía total descargada de la batería - Lógica Robusta
# Energía total descargada de la batería
- state_topic: "energy/growatt"
  unique_id: "battery_discharged_total"
  name: "Battery Discharged Energy - Total"
  value_template: >-
    {% if value_json.get('device') == '<INVERTER_SERIAL>' and value_json.get('values', {}).get('edischrtotal') is not none %}
      {% set nuevo_valor = value_json['values']['edischrtotal'] | float(-1) / 10 %}
      {% set actual = this.state | float(-1) %}
      
      {% if nuevo_valor > 0 %}
        {% if actual == -1 %}
          {{ nuevo_valor }}
        {% elif nuevo_valor >= actual and (nuevo_valor - actual) < 1000 %}
          {{ nuevo_valor }}
        {% else %}
          {{ this.state }}
        {% endif %}
      {% else %}
        {{ this.state }}
      {% endif %}
    {% else %}
      {{ this.state if this.state is defined else 'unknown' }}
    {% endif %}
  unit_of_measurement: "kWh"
  device_class: "energy"
  state_class: "total_increasing"
  icon: "mdi:battery-arrow-down"
  device: *growatt_device

# Energía total cargada en la batería
- state_topic: "energy/growatt"
  unique_id: "battery_charged_total"
  name: "Battery Charged Energy - Total"
  value_template: >-
    {% if value_json.get('device') == '<INVERTER_SERIAL>' and value_json.get('values', {}).get('echrtotal') is not none %}
      {% set nuevo_valor = value_json['values']['echrtotal'] | float(-1) / 10 %}
      {% set actual = this.state | float(-1) %}
      
      {% if nuevo_valor > 0 %}
        {% if actual == -1 %}
          {{ nuevo_valor }}
        {% elif nuevo_valor >= actual and (nuevo_valor - actual) < 1000 %}
          {{ nuevo_valor }}
        {% else %}
          {{ this.state }}
        {% endif %}
      {% else %}
        {{ this.state }}
      {% endif %}
    {% else %}
      {{ this.state if this.state is defined else 'unknown' }}
    {% endif %}
  unit_of_measurement: "kWh"
  device_class: "energy"
  state_class: "total_increasing"
  icon: "mdi:battery-arrow-up"
  device: *growatt_device


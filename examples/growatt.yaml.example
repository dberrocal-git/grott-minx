  value_template: >-
    {% if value_json.device == '<INVERTER_SERIAL>' %}
      {{ value_json['values']['bdc1_pchr'] | float / 10 }}
    {% endif %}
  unit_of_measurement: "W"
  device_class: "power"
  state_class: "measurement"
  icon: "mdi:battery-plus-outline"
  expire_after: 120
  device: *growatt_device

# Corriente máxima de la batería
- state_topic: "energy/growatt"
  unique_id: "battery_max_current"
  name: "BMS Max Current"
  value_template: >-
    {% if value_json.device == '<INVERTER_SERIAL>' %}
      {{ value_json['values']['bms_maxcurr'] | float / 100 }}
    {% endif %}
  unit_of_measurement: "A"
  device_class: "current"
  state_class: "measurement"
  icon: "mdi:current-dc"
  expire_after: 120
  device: *growatt_device

# Delta de voltaje de batería
- state_topic: "energy/growatt"
  unique_id: "battery_delta_voltage"
  name: "BMS Delta Voltage"
  value_template: >-
    {% if value_json.device == '<INVERTER_SERIAL>' %}
      {{ value_json['values']['bms_deltavolt'] | float / 100 }}
    {% endif %}
  unit_of_measurement: "V"
  device_class: "voltage"
  state_class: "measurement"
  icon: "mdi:battery-minus"
  expire_after: 120
  device: *growatt_device

# BDC1 Battery Voltage
- state_topic: "energy/growatt"
  unique_id: "bdc1_battery_voltage"
  name: "BDC1 Battery Voltage"
  value_template: >-
    {% if value_json.device == '<INVERTER_SERIAL>' %}
      {{ value_json['values']['bdc1_vbat'] | float / 100 }}
    {% endif %}
  unit_of_measurement: "V"
  device_class: "voltage"
  state_class: "measurement"
  icon: "mdi:battery"
  expire_after: 120
  device: *growatt_device

# BDC1 Battery Current
- state_topic: "energy/growatt"
  unique_id: "bdc1_battery_current"
  name: "BDC1 Battery Current"
  value_template: >-
    {% if value_json.device == '<INVERTER_SERIAL>' %}
      {% set raw = value_json['values']['bdc1_ibat'] | int %}
      {% set signed = raw if raw < 32768 else raw - 65536 %}
      {{ signed / 10 }}
    {% endif %}
  unit_of_measurement: "A"
  device_class: "current"
  state_class: "measurement"
  icon: "mdi:current-dc"
  expire_after: 120
  device: *growatt_device


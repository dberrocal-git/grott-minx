################################
# BATERÍA - PARÁMETROS        #
################################

# Voltaje de batería
- state_topic: "energy/growatt"
  unique_id: "battery_voltage"
  name: "BMS Battery Voltage"
  value_template: >-
    {% if value_json.device == '<INVERTER_SERIAL>' %}
      {{ value_json['values']['bms_batteryvolt'] | float / 100 }}
    {% endif %}
  unit_of_measurement: "V"
  device_class: "voltage"
  state_class: "measurement"
  icon: "mdi:battery-charging"
  expire_after: 120
  device: *growatt_device

# Corriente de batería
- state_topic: "energy/growatt"
  unique_id: "battery_current"
  name: "BMS Battery Current"
  value_template: >-
    {% if value_json.device == '<INVERTER_SERIAL>' %}
      {% set raw = value_json['values']['bms_batterycurr'] | int %}
      {% set signed = raw if raw < 32768 else raw - 65536 %}
      {{ signed / 100 }}
    {% endif %}
  unit_of_measurement: "A"
  device_class: "current"
  state_class: "measurement"
  icon: "mdi:battery-charging-outline"
  expire_after: 120
  device: *growatt_device

# Potencia de descarga de batería
- state_topic: "energy/growatt"
  unique_id: "battery_discharge_power"
  name: "BDC1 Discharge Power"
  value_template: >-
    {% if value_json.device == '<INVERTER_SERIAL>' %}
      {{ value_json['values']['bdc1_pdischr'] | float / 10  }}
    {% endif %}
  unit_of_measurement: "W"
  device_class: "power"
  state_class: "measurement"
  icon: "mdi:battery-minus-outline"
  expire_after: 120
  device: *growatt_device

# Potencia de carga de batería
- state_topic: "energy/growatt"
  unique_id: "battery_charge_power"
